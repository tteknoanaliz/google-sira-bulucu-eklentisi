{
  "manifest_version": 3,
  "name": "Google Sıra Bulucu",
  "version": "1.5",
  "description": "Google sonuçlarında hedef sitenizin sırasını otomatik bulur ve derin tarama yapar.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["content.js"]
    }
  ]
}